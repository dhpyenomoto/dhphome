# ===== データベース接続 =====
# 開発（SQLite）。本番（PostgreSQL）へ切替時は prisma/schema.prisma の
# datasource provider を "postgresql" に変更し、下記 URL を差し替えて
# `npm run prisma:deploy` を実行してください（README 参照）。
DATABASE_URL="file:./dev.db"
# 本番（PostgreSQL）の例：
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dhpdatabase?schema=public"

# ===== セッション署名鍵 =====
# 32文字以上のランダム文字列。本番では必ず変更してください。
# 生成例: openssl rand -base64 48
AUTH_SECRET="change-me-please-use-a-long-random-secret-string"
